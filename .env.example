# Скопируйте этот файл под именем .env и заполните.

# Токен бота от @BotFather (команда /newbot)
BOT_TOKEN=

# Telegram ID мастера (и ваш, если показываете бота на демо). Несколько — через запятую.
# Узнать свой ID: написать боту @userinfobot
ADMIN_IDS=

# Часовой пояс салона
TIMEZONE=Europe/Moscow

# false — запись подтверждает мастер кнопкой «Принять»
# true  — запись подтверждается автоматически
AUTO_CONFIRM=false
